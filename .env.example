# Copy to .env and fill in. Never commit .env.

RAG_ENVIRONMENT=local
RAG_LOG_LEVEL=INFO

RAG_DATABASE_URL=postgresql+psycopg://rag_user:changeme@localhost:5432/platform

# Comma-separated. Java sends one of these as X-Internal-Key.
RAG_INBOUND_API_KEYS=["local-dev-key"]

RAG_EMBEDDING_PROVIDER=fake
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSION=1024

RAG_CHUNK_TARGET_TOKENS=500
RAG_CHUNK_MAX_TOKENS=800

RAG_DEFAULT_TOP_K=8
RAG_CANDIDATE_MULTIPLIER=8
RAG_RERANK_ENABLED=false
